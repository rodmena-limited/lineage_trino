digraph Lineage {
  rankdir=LR;
  bgcolor="#f8f9fa";
  fontname="Helvetica";
  labeljust=l;
  pad=0.5;
  nodesep=0.8;
  ranksep=2.0;
  splines=polyline;
  newrank=true;

  node [
    shape=plain, 
    fontname="Helvetica", 
    fontsize=11, 
    margin=0, 
  ];

  edge [
    fontname="Helvetica", 
    fontsize=9, 
    arrowsize=0.8, 
  ];

